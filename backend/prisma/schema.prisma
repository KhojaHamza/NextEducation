generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  PARENT
  STUDENT
  ACCOUNTANT
  SUPER_ADMIN
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Gender {
  MALE
  FEMALE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model School {
  id              Int          @id @default(autoincrement())
  code            String       @unique
  name            String
  status          SchoolStatus @default(TRIAL)
  plan            String       @default("basic")
  subscriptionEnd DateTime?    @db.Date
  currency        String       @default("TND")
  address         String?
  phone           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users               User[]
  schoolYears         SchoolYear[]
  teachers            Teacher[]
  parents             Parent[]
  students            Student[]
  studentParents      StudentParent[]
  classes             SchoolClass[]
  enrollments         Enrollment[]
  subjects            Subject[]
  rooms               Room[]
  teachingAssignments TeachingAssignment[]
  auditLogs           AuditLog[]
  evaluations         Evaluation[]
  grades              Grade[]
  absences            Absence[]
  feeItems            FeeItem[]
  payments            Payment[]
  notifications       Notification[]
  messages            Message[]
  messageRecipients   MessageRecipient[]
  messageAttachments  MessageAttachment[]
  messageAccessLogs   MessageAccessLog[]
  announcements       Announcement[]
  pushSubscriptions   PushSubscription[]
  timetableSlots      TimetableSlot[]

  homeworks   Homework[]
  schoolEvents SchoolEvent[]

  @@map("schools")
}

model SchoolYear {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  school    School    @relation(fields: [schoolId], references: [id])
  label     String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  classes     SchoolClass[]
  enrollments Enrollment[]
  students    Student[]
  absences    Absence[]
  feeItems    FeeItem[]
  payments    Payment[]

  @@unique([schoolId, label])
  @@index([schoolId])
  @@map("school_years")
}

model User {
  id                 Int       @id @default(autoincrement())
  schoolId           Int?
  school             School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  email              String
  passwordHash       String
  role               Role
  firstName          String
  lastName           String
  phone              String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  teacher   Teacher?
  parent    Parent?
  student   Student?
  auditLogs AuditLog[]

  absencesRecorded      Absence[]
  notifications         Notification[]
  paymentsRecorded      Payment[]          @relation("PaymentRecordedBy")
  paymentsCancelled     Payment[]          @relation("PaymentCancelledBy")
  messagesSent          Message[]          @relation("MessageSender")
  messagesReceived      MessageRecipient[]
  messageAccessLogs     MessageAccessLog[]
  announcementsAuthored Announcement[]     @relation("AnnouncementAuthor")
  pushSubscriptions     PushSubscription[]

  @@unique([schoolId, email])
  @@index([schoolId])
  homeworksAuthored Homework[] @relation("HomeworkAuthor")

  @@map("users")
}

model Teacher {
  id         Int       @id @default(autoincrement())
  schoolId   Int
  school     School    @relation(fields: [schoolId], references: [id])
  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id])
  speciality String?
  hiredAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  homeroomClasses SchoolClass[]
  assignments     TeachingAssignment[]
  timetableSlots  TimetableSlot[]

  @@index([schoolId])
  @@map("teachers")
}

model Parent {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  school    School    @relation(fields: [schoolId], references: [id])
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id])
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  children StudentParent[]

  @@index([schoolId])
  @@map("parents")
}

model Student {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  school       School     @relation(fields: [schoolId], references: [id])
  userId       Int?       @unique
  user         User?      @relation(fields: [userId], references: [id])
  matricule    String
  firstName    String
  lastName     String
  birthDate    DateTime
  gender       Gender
  photoUrl     String?
  medicalNotes String?
  entryYearId  Int        @map("annee_scolaire_entree_id")
  entryYear    SchoolYear @relation(fields: [entryYearId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  parents     StudentParent[]
  enrollments Enrollment[]
  grades      Grade[]
  absences    Absence[]
  payments    Payment[]
  messages    Message[]

  @@unique([schoolId, matricule])
  @@index([schoolId])
  @@map("students")
}

model StudentParent {
  schoolId     Int
  school       School   @relation(fields: [schoolId], references: [id])
  studentId    Int
  parentId     Int
  relationship String
  student      Student  @relation(fields: [studentId], references: [id])
  parent       Parent   @relation(fields: [parentId], references: [id])

  @@id([studentId, parentId])
  @@index([schoolId])
  @@map("student_parents")
}

model SchoolClass {
  id                Int        @id @default(autoincrement())
  schoolId          Int
  school            School     @relation(fields: [schoolId], references: [id])
  level             String
  section           String
  capacity          Int
  schoolYearId      Int        @map("annee_scolaire_id")
  schoolYear        SchoolYear @relation(fields: [schoolYearId], references: [id])
  homeroomTeacherId Int?
  homeroomTeacher   Teacher?   @relation(fields: [homeroomTeacherId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  enrollments    Enrollment[]
  assignments    TeachingAssignment[]
  evaluations    Evaluation[]
  absences       Absence[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, level, section, schoolYearId])
  @@index([schoolId])
  homeworks Homework[]

  @@map("classes")
}

model Enrollment {
  id           Int         @id @default(autoincrement())
  schoolId     Int
  school       School      @relation(fields: [schoolId], references: [id])
  studentId    Int
  classId      Int
  schoolYearId Int         @map("annee_scolaire_id")
  student      Student     @relation(fields: [studentId], references: [id])
  schoolClass  SchoolClass @relation(fields: [classId], references: [id])
  schoolYear   SchoolYear  @relation(fields: [schoolYearId], references: [id])
  enrolledAt   DateTime    @default(now())
  deletedAt    DateTime?

  @@unique([studentId, schoolYearId])
  @@index([schoolId])
  @@map("enrollments")
}

model Subject {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])
  name        String
  coefficient Decimal   @db.Decimal(4, 2)
  level       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  assignments    TeachingAssignment[]
  evaluations    Evaluation[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, name, level])
  @@index([schoolId])
  homeworks Homework[]

  @@map("subjects")
}

model Room {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])
  name        String
  capacity    Int
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  timetableSlots TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("rooms")
}

model TeachingAssignment {
  id          Int         @id @default(autoincrement())
  schoolId    Int
  school      School      @relation(fields: [schoolId], references: [id])
  teacherId   Int
  subjectId   Int
  classId     Int
  teacher     Teacher     @relation(fields: [teacherId], references: [id])
  subject     Subject     @relation(fields: [subjectId], references: [id])
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  deletedAt   DateTime?

  @@unique([teacherId, subjectId, classId])
  @@index([schoolId])
  @@map("teaching_assignments")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("audit_logs")
}

enum Term {
  T1
  T2
  T3
}

enum EvaluationType {
  CONTINUOUS
  EXAM
}

enum AbsencePeriod {
  MORNING
  AFTERNOON
}

enum JustificationStatus {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}

model Evaluation {
  id        Int            @id @default(autoincrement())
  schoolId  Int
  school    School         @relation(fields: [schoolId], references: [id])
  title     String
  type      EvaluationType
  term      Term
  date      DateTime       @db.Date
  maxScore  Decimal        @default(20) @db.Decimal(5, 2)
  weight    Decimal        @default(1) @db.Decimal(4, 2)
  classId   Int
  subjectId Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  subject     Subject     @relation(fields: [subjectId], references: [id])
  grades      Grade[]

  @@index([classId, subjectId, term])
  @@index([schoolId])
  @@map("evaluations")
}

model Grade {
  id           Int       @id @default(autoincrement())
  schoolId     Int
  school       School    @relation(fields: [schoolId], references: [id])
  evaluationId Int
  studentId    Int
  score        Decimal   @db.Decimal(5, 2)
  comment      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([evaluationId, studentId])
  @@index([schoolId])
  @@map("grades")
}

model Absence {
  id                  Int                 @id @default(autoincrement())
  schoolId            Int
  school              School              @relation(fields: [schoolId], references: [id])
  studentId           Int
  classId             Int
  schoolYearId        Int                 @map("annee_scolaire_id")
  date                DateTime            @db.Date
  period              AbsencePeriod
  justificationStatus JustificationStatus @default(NONE)
  justificationReason String?
  reviewNote          String?
  reviewedAt          DateTime?
  recordedById        Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  student     Student     @relation(fields: [studentId], references: [id])
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  schoolYear  SchoolYear  @relation(fields: [schoolYearId], references: [id])
  recordedBy  User?       @relation(fields: [recordedById], references: [id])

  @@unique([studentId, date, period])
  @@index([classId, date])
  @@index([schoolId])
  @@map("absences")
}

enum FeeType {
  REGISTRATION
  TUITION
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model FeeItem {
  id           Int       @id @default(autoincrement())
  schoolId     Int
  school       School    @relation(fields: [schoolId], references: [id])
  schoolYearId Int       @map("annee_scolaire_id")
  name         String
  type         FeeType
  level        String?
  amount       Decimal   @db.Decimal(10, 3)
  dueDate      DateTime  @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  @@index([schoolYearId])
  @@index([schoolId])
  @@map("fee_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  schoolId      Int
  school        School        @relation(fields: [schoolId], references: [id])
  receiptNumber String
  studentId     Int
  schoolYearId  Int           @map("annee_scolaire_id")
  amount        Decimal       @db.Decimal(10, 3)
  method        PaymentMethod
  reference     String?
  note          String?
  paidAt        DateTime      @db.Date
  recordedById  Int?
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student     Student    @relation(fields: [studentId], references: [id])
  schoolYear  SchoolYear @relation(fields: [schoolYearId], references: [id])
  recordedBy  User?      @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  cancelledBy User?      @relation("PaymentCancelledBy", fields: [cancelledById], references: [id])

  @@unique([schoolId, receiptNumber])
  @@index([studentId, schoolYearId])
  @@index([schoolId])
  @@map("payments")
}

model Notification {
  id        Int                 @id @default(autoincrement())
  schoolId  Int
  school    School              @relation(fields: [schoolId], references: [id])
  userId    Int
  type      String
  channel   NotificationChannel
  title     String
  body      String
  data      Json?
  status    NotificationStatus
  error     String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([schoolId])
  @@map("notifications")
}

enum MessageStatus {
  DRAFT
  SENT
}

enum MessageAccessAction {
  VIEW_THREAD
  DOWNLOAD_ATTACHMENT
}

model Message {
  id        Int           @id @default(autoincrement())
  schoolId  Int
  school    School        @relation(fields: [schoolId], references: [id])
  threadId  Int?
  senderId  Int
  studentId Int?
  subject   String        @default("")
  body      String        @default("")
  important Boolean       @default(false)
  status    MessageStatus @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  sender      User                @relation("MessageSender", fields: [senderId], references: [id])
  student     Student?            @relation(fields: [studentId], references: [id])
  thread      Message?            @relation("MessageThread", fields: [threadId], references: [id])
  replies     Message[]           @relation("MessageThread")
  recipients  MessageRecipient[]
  attachments MessageAttachment[]

  @@index([threadId])
  @@index([senderId, status])
  @@index([schoolId])
  @@map("messages")
}

model MessageRecipient {
  schoolId  Int
  school    School    @relation(fields: [schoolId], references: [id])
  messageId Int
  userId    Int
  readAt    DateTime?
  hiddenAt  DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([messageId, userId])
  @@index([userId, hiddenAt])
  @@index([schoolId])
  @@map("message_recipients")
}

model MessageAttachment {
  id         Int      @id @default(autoincrement())
  schoolId   Int
  school     School   @relation(fields: [schoolId], references: [id])
  messageId  Int
  fileName   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("message_attachments")
}

model MessageAccessLog {
  id           Int                 @id @default(autoincrement())
  schoolId     Int
  school       School              @relation(fields: [schoolId], references: [id])
  userId       Int
  threadId     Int
  messageId    Int?
  attachmentId Int?
  action       MessageAccessAction
  createdAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([threadId, createdAt])
  @@index([userId, createdAt])
  @@index([schoolId])
  @@map("message_access_logs")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id])
  title       String
  body        String
  audience    Role[]
  correctsId  Int?
  authorId    Int
  publishedAt DateTime @default(now())

  author      User           @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  corrects    Announcement?  @relation("AnnouncementCorrection", fields: [correctsId], references: [id])
  corrections Announcement[] @relation("AnnouncementCorrection")

  @@index([publishedAt])
  @@index([schoolId])
  @@map("announcements")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  userId    Int
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([schoolId])
  @@map("push_subscriptions")
}

model TimetableSlot {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])
  classId     Int
  subjectId   Int
  teacherId   Int
  roomId      Int?
  dayOfWeek   DayOfWeek
  startMinute Int
  endMinute   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  subject     Subject     @relation(fields: [subjectId], references: [id])
  teacher     Teacher     @relation(fields: [teacherId], references: [id])
  room        Room?       @relation(fields: [roomId], references: [id])

  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomId, dayOfWeek])
  @@index([schoolId])
  @@map("timetable_slots")
}
model PlatformAuditLog {
  id             Int      @id @default(autoincrement())
  userId         Int?
  action         String
  entity         String
  entityId       Int?
  targetSchoolId Int?
  details        Json?
  createdAt      DateTime @default(now())

  @@index([targetSchoolId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}
model Homework {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])
  classId     Int
  subjectId   Int
  authorId    Int
  title       String
  description String
  dueDate     DateTime  @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  subject     Subject     @relation(fields: [subjectId], references: [id])
  author      User        @relation("HomeworkAuthor", fields: [authorId], references: [id])

  @@index([classId, dueDate])
  @@index([schoolId])
  @@map("homeworks")
}

model SchoolEvent {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      School    @relation(fields: [schoolId], references: [id])
  title       String
  description String?
  date        DateTime  @db.Date
  endDate     DateTime? @db.Date
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([schoolId, date])
  @@map("school_events")
}